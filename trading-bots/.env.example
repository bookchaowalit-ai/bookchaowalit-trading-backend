# Database Configuration - Neon PostgreSQL
# Your Neon PostgreSQL database URL
DATABASE_URL=postgresql://neondb_owner:your_password@ep-divine-breeze-a1pi1zf0-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Crypto Exchange APIs
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_SECRET_KEY=your_coinbase_secret_key
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET_KEY=your_bybit_secret_key

# Bitkub APIs (Thai Crypto Exchange)
BITKUB_API_KEY=your_bitkub_api_key
BITKUB_SECRET_KEY=your_bitkub_secret_key
BITKUB_BASE_URL=https://api.bitkub.com

# Stock Trading APIs
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use paper trading for testing

# Forex Trading APIs
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id
OANDA_ENVIRONMENT=practice  # practice or live

# InnovestX APIs (Thai Stock Market)
INNOVESTX_API_KEY=your_innovestx_api_key
INNOVESTX_SECRET_KEY=your_innovestx_secret_key
INNOVESTX_BASE_URL=https://api.innovestxonline.com
INNOVESTX_ENVIRONMENT=sandbox  # sandbox or production

# Bot Configuration
LOG_LEVEL=INFO
TRADING_MODE=paper  # paper or live
MAX_POSITION_SIZE=1000
RISK_PERCENTAGE=2
